<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.gustavosa</groupId>
    <artifactId>url-shortener</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>url-shortener</name>
    <description>API REST que encurta URLs — primeiro produto-piloto da fabrica</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation. Presente desde o início porque validar entrada
             não é opcional, e adicionar depois costuma significar nunca. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator: expõe /actuator/health, usado pelo HEALTHCHECK do
             container e por qualquer proxy à frente. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway versiona o schema. O Hibernate fica com ddl-auto=validate:
             quem cria tabela é a migração, nunca o ORM. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Os testes de integração usam um PostgreSQL real, provisionado
             fora do build: `docker compose up -d db` localmente, e o bloco
             `services:` do workflow no CI.

             Testcontainers seria o padrão da fábrica e foi a primeira escolha,
             mas está BLOQUEADO neste ambiente — ver docs/adr/0003. Testar
             contra H2 não é alternativa: as migrações usam BIGSERIAL,
             TIMESTAMPTZ e SEQUENCE, então o schema validado seria outro. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
